{
  "manifest_version": 3,
  "name": "CraveSense",
  "version": "1.0.0",
  "description": "An AI-powered craving tracker and diet intervention assistant.",
  "permissions": ["storage", "notifications", "tabs"],
  "host_permissions": ["http://localhost:5000/*", "http://localhost:5173/*"],
  "action": {
    "default_title": "CraveSense",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
